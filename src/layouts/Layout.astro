---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Catatan Keuangan Keluarga Baba & Umma + Usaha Ibu",
  description = "Aplikasi Keuangan Keluarga Baba Pangestu & Umma Atin serta Usaha Ibu. Simpel, cepat, cerah, terintegrasi Google Sheets."
} = Astro.props;

// Build Timestamp Unik: Menjamin browser selalu memuat kode terbaru saat deploy baru tanpa perlu Hard Refresh (F5)
const buildTime = Date.now();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!DOCTYPE html>
<html lang="id" data-theme="emerald">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>{title}</title>
  <meta name="description" content={description}>
  
  <!-- Anti-Stale Cache Control: Mencegah browser menyandera halaman lama -->
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">

  <link rel="manifest" href={`${base}/manifest.json`}>
  <meta name="theme-color" content="#10b981">
  <link rel="stylesheet" href={`${base}/styles.css?v=${buildTime}`}>
  
  <!-- Tailwind CSS CDN -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <!-- Chart.js CDN -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- Lucide Icons CDN -->
  <script is:inline src="https://unpkg.com/lucide@latest"></script>
  <!-- Tesseract.js OCR CDN (Deferred for speed) -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/tesseract.js@4/dist/tesseract.min.js" defer></script>
</head>
<body class="bg-slate-50 text-slate-800 antialiased selection:bg-emerald-100">
  
  <slot />

  <!-- Core Client-Side Logic & Business Modules (Dengan Version Cache-Buster Otomatis) -->
  <script is:inline src={`${base}/ui-dialog.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/date-helper.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/categories.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/auth.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/settings.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/bills.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/goals.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/education.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/family-parents.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/vehicle-service.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/investments.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/ibu-gas.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/ibu-kost.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/monthly-stats.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/analytics-health.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/sync.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/app.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/whatsapp.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/export-reports.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/ocr.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/shopping-list.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/backup-restore.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/community.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/taxes-holidays.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/kondangan-social.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/emergency-fund.js?v=${buildTime}`}></script>
  <script is:inline src={`${base}/page-controller.js?v=${buildTime}`}></script>

  <!-- PWA Service Worker Registration: Auto-Update & Auto-Reload Saat Ada Versi Baru -->
  <script is:inline define:vars={{ buildTime, base }}>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        const swUrl = (base ? base : '') + '/sw.js?v=' + buildTime;
        const swScope = (base ? base : '') + '/';
        navigator.serviceWorker.register(swUrl, { scope: swScope }).then(reg => {
          // Paksa periksa update ke server setiap kali aplikasi dibuka
          reg.update();

          // Deteksi apakah worker baru sedang diinstall
          reg.addEventListener('updatefound', () => {
            const newWorker = reg.installing;
            if (newWorker) {
              newWorker.addEventListener('statechange', () => {
                // Jika worker baru telah aktif dan menggantikan versi lama
                if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                  console.log("Pembaruan versi baru terdeteksi! Memuat versi terbaru...");
                  window.location.reload();
                }
              });
            }
          });
        }).catch(err => {
          console.log('ServiceWorker error:', err);
        });

        // Tangani controller change untuk auto-reload instan tanpa F5
        let refreshing = false;
        navigator.serviceWorker.addEventListener('controllerchange', () => {
          if (!refreshing) {
            refreshing = true;
            window.location.reload();
          }
        });
      });
    }
  </script>
</body>
</html>
