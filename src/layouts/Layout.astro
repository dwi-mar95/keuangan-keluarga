---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Catatan Keuangan Keluarga Baba & Umma + Usaha Ibu",
  description = "Aplikasi Keuangan Keluarga Baba Pangestu & Umma Atin serta Usaha Ibu. Simpel, cepat, cerah, terintegrasi Google Sheets."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id" data-theme="emerald">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#10b981">
  <link rel="stylesheet" href="/styles.css">
  
  <!-- Tailwind CSS CDN -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <!-- Chart.js CDN -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- Lucide Icons CDN -->
  <script is:inline src="https://unpkg.com/lucide@latest"></script>
  <!-- Tesseract.js OCR CDN (Deferred for speed) -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/tesseract.js@4/dist/tesseract.min.js" defer></script>
</head>
<body class="bg-slate-50 text-slate-800 antialiased selection:bg-emerald-100">
  
  <slot />

  <!-- Core Client-Side Logic & Business Modules -->
  <script is:inline src="/date-helper.js"></script>
  <script is:inline src="/categories.js"></script>
  <script is:inline src="/auth.js"></script>
  <script is:inline src="/settings.js"></script>
  <script is:inline src="/bills.js"></script>
  <script is:inline src="/goals.js"></script>
  <script is:inline src="/education.js"></script>
  <script is:inline src="/family-parents.js"></script>
  <script is:inline src="/vehicle-service.js"></script>
  <script is:inline src="/investments.js"></script>
  <script is:inline src="/ibu-gas.js"></script>
  <script is:inline src="/ibu-kost.js"></script>
  <script is:inline src="/monthly-stats.js"></script>
  <script is:inline src="/analytics-health.js"></script>
  <script is:inline src="/sync.js"></script>
  <script is:inline src="/app.js"></script>
  <script is:inline src="/ui-dialog.js"></script>
  <script is:inline src="/whatsapp.js"></script>
  <script is:inline src="/export-reports.js"></script>
  <script is:inline src="/ocr.js"></script>
  <script is:inline src="/shopping-list.js"></script>
  <script is:inline src="/backup-restore.js"></script>
  <script is:inline src="/community.js"></script>
  <script is:inline src="/taxes-holidays.js"></script>
  <script is:inline src="/kondangan-social.js"></script>
  <script is:inline src="/emergency-fund.js"></script>
  <script is:inline src="/page-controller.js"></script>

  <!-- PWA Service Worker Registration -->
  <script is:inline>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').then(reg => {
          console.log('ServiceWorker registered:', reg.scope);
        }).catch(err => {
          console.log('ServiceWorker error:', err);
        });
      });
    }
  </script>
</body>
</html>
