---
---
  <!-- ================= MODAL: QUICK ADD TRANSACTION ================= -->
  <div id="quickAddModal" class="modal-backdrop hidden">
    <div class="modal-content space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <div class="flex items-center gap-2">
          <div class="flex p-0.5 bg-slate-100 rounded-lg">
            <button id="btnTxExpense" onclick="setTxType('expense')" class="px-3 py-1 rounded-md text-xs font-extrabold bg-rose-500 text-white">
              Pengeluaran
            </button>
            <button id="btnTxIncome" onclick="setTxType('income')" class="px-3 py-1 rounded-md text-xs font-extrabold text-slate-500">
              Pemasukan
            </button>
          </div>
        </div>
        <button onclick="closeQuickAddModal()" class="w-7 h-7 rounded-full bg-slate-100 text-slate-400 hover:text-slate-700 flex items-center justify-center">
          ✕
        </button>
      </div>

      <!-- Nominal Display & Tools (Voice & OCR) -->
      
      <!-- Pemilih Tanggal Transaksi (Mendukung Backdate Tanggal Lalu) -->
      <div class="space-y-1">
        <label class="text-[10.5px] font-bold text-slate-500 uppercase flex items-center justify-between">
          <span>Tanggal Transaksi (Bisa Backdate):</span>
          <span class="text-[9.5px] text-emerald-600 font-bold">WIB (UTC+7)</span>
        </label>
        <input type="date" id="txDateInput" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-800 outline-none cursor-pointer">
      </div>

      <div class="bg-slate-50 border border-slate-200/80 rounded-2xl p-4 space-y-2">
        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider flex items-center justify-between">
          <span>Nominal Transaksi (Rp):</span>
          <div class="flex items-center gap-2">
            <!-- Voice Input Button -->
            <button onclick="handleVoiceInputClick()" id="btnVoiceInput" class="px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800 text-[10px] font-extrabold flex items-center gap-1 cursor-pointer">
              🎙️ Bicara
            </button>
            <!-- OCR Camera Button -->
            <label class="px-2 py-0.5 rounded-md bg-blue-100 text-blue-800 text-[10px] font-extrabold flex items-center gap-1 cursor-pointer">
              📸 Foto Struk
              <input type="file" accept="image/*" capture="environment" onchange="handleOcrFileChange(event)" class="hidden">
            </label>
          </div>
        </div>
        <div id="numpadDisplay" class="text-3xl font-black text-slate-900 tracking-tight">
          0
        </div>
      </div>

      <!-- Kategori Selector -->
      <div class="space-y-1">
        <div class="flex items-center justify-between">
          <label class="text-[10.5px] font-bold text-slate-500 uppercase">Pilih Pos Kategori:</label>
          <button type="button" onclick="openCategoryManagerModal()" class="text-[10px] font-bold text-emerald-600 hover:text-emerald-700 cursor-pointer flex items-center gap-1 bg-emerald-50 hover:bg-emerald-100 px-2 py-0.5 rounded-md transition-all">
            <span>⚙️ + / Kelola Kategori</span>
          </button>
        </div>
        <select id="txCategorySelect" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-800 outline-none">
          <!-- Populated by JS -->
        </select>
      </div>

      <!-- Dompet / Sumber Dana & Pencatat -->
      <div class="grid grid-cols-2 gap-2.5">
        <div class="space-y-1">
          <label class="text-[10.5px] font-bold text-slate-500 uppercase">Dompet / Akun:</label>
          <select id="txWalletSelect" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-800 outline-none">
            <option value="Kas Tunai Suami">Kas Tunai Suami</option>
            <option value="Kas Dapur (Istri)" selected>Kas Dapur (Istri)</option>
            <option value="Rekening BCA">Rekening BCA</option>
            <option value="Rekening Mandiri / BRI">Mandiri / BRI</option>
            <option value="ShopeePay (Istri)">ShopeePay</option>
            <option value="GoPay / OVO / DANA">GoPay / OVO</option>
          </select>
        </div>
        <div class="space-y-1">
          <label class="text-[10.5px] font-bold text-slate-500 uppercase">Pencatat:</label>
          <select id="txUserSelect" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-800 outline-none">
            <option value="istri" selected>👩 Umma Atin (Istri)</option>
            <option value="suami">👨 Baba Pangestu</option>
          </select>
        </div>
      </div>

      <!-- Catatan Keterangan -->
      <div class="space-y-1">
        <input type="text" id="txNoteInput" placeholder="Keterangan (misal: Beras 5kg & sayur bayam)..." class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold text-slate-800 outline-none">
      </div>

      <!-- Numpad Keypad with Calculator Functions (+, -, =, C) -->
      <div class="numpad-grid-4 pt-1">
        <button type="button" onclick="pressNumpad('1')" class="numpad-btn">1</button>
        <button type="button" onclick="pressNumpad('2')" class="numpad-btn">2</button>
        <button type="button" onclick="pressNumpad('3')" class="numpad-btn">3</button>
        <button type="button" onclick="pressNumpad('+')" class="numpad-btn numpad-op-btn text-emerald-600 font-black" title="Tambah (+)">+</button>

        <button type="button" onclick="pressNumpad('4')" class="numpad-btn">4</button>
        <button type="button" onclick="pressNumpad('5')" class="numpad-btn">5</button>
        <button type="button" onclick="pressNumpad('6')" class="numpad-btn">6</button>
        <button type="button" onclick="pressNumpad('-')" class="numpad-btn numpad-op-btn text-amber-600 font-black" title="Kurang (-)">−</button>

        <button type="button" onclick="pressNumpad('7')" class="numpad-btn">7</button>
        <button type="button" onclick="pressNumpad('8')" class="numpad-btn">8</button>
        <button type="button" onclick="pressNumpad('9')" class="numpad-btn">9</button>
        <button type="button" onclick="pressNumpad('=')" class="numpad-btn numpad-op-btn text-blue-600 font-black" title="Hitung Hasil (=)">=</button>

        <button type="button" onclick="pressNumpad('000')" class="numpad-btn text-xs font-black">000</button>
        <button type="button" onclick="pressNumpad('0')" class="numpad-btn">0</button>
        <button type="button" onclick="pressNumpad('del')" class="numpad-btn text-rose-500 font-bold" title="Hapus">⌫</button>
        <button type="button" onclick="clearCalcAndNumpad()" class="numpad-btn text-slate-400 text-xs font-black" title="Hapus Total">C</button>
      </div>

      <!-- Action Button Submit -->
      <button onclick="submitQuickAddTransaction()" class="w-full py-3 rounded-xl bg-emerald-500 hover:bg-emerald-600 active:scale-98 text-white font-black text-sm transition-all shadow-md cursor-pointer flex items-center justify-center gap-2">
        <span>💾 Simpan Transaksi</span>
      </button>
    </div>
  </div>

  <!-- ================= MODAL: PENGATURAN (SETTINGS) ================= -->
  <div id="settingsModal" class="modal-backdrop hidden">
    <div class="modal-content space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <h3 class="text-sm font-black text-slate-900">Pengaturan Keluarga & Sistem</h3>
        <button onclick="closeSettingsModal()" class="w-7 h-7 rounded-full bg-slate-100 text-slate-400 hover:text-slate-700 flex items-center justify-center">✕</button>
      </div>

      <!-- Nama Keluarga Dinamis -->
      <div class="space-y-1">
        <label class="text-[10.5px] font-bold text-slate-500 uppercase">Nama Judul Keluarga:</label>
        <input type="text" id="settingFamilyNameInput" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-800">
      </div>

      <!-- Preset Logo Cerah -->
      <div class="space-y-1">
        <label class="text-[10.5px] font-bold text-slate-500 uppercase">Pilih Ikon Logo Cerah:</label>
        <div class="flex gap-2 overflow-x-auto no-scrollbar py-1" id="presetIconContainer">
          <button type="button" onclick="selectPresetIcon('\u{1F3E1}')" class="icon-choice-btn w-11 h-11 rounded-xl border border-slate-200 text-xl hover:border-emerald-400 hover:bg-slate-50 flex items-center justify-center cursor-pointer transition-all shadow-2xs">🏡</button>
          <button type="button" onclick="selectPresetIcon('\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}')" class="icon-choice-btn w-11 h-11 rounded-xl border border-slate-200 text-xl hover:border-emerald-400 hover:bg-slate-50 flex items-center justify-center cursor-pointer transition-all shadow-2xs">👨‍👩‍👧‍👦</button>
          <button type="button" onclick="selectPresetIcon('\u{1F338}')" class="icon-choice-btn w-11 h-11 rounded-xl border border-slate-200 text-xl hover:border-emerald-400 hover:bg-slate-50 flex items-center justify-center cursor-pointer transition-all shadow-2xs">🌸</button>
          <button type="button" onclick="selectPresetIcon('\u{1F31F}')" class="icon-choice-btn w-11 h-11 rounded-xl border border-slate-200 text-xl hover:border-emerald-400 hover:bg-slate-50 flex items-center justify-center cursor-pointer transition-all shadow-2xs">🌟</button>
          <button type="button" onclick="selectPresetIcon('\u{1F48E}')" class="icon-choice-btn w-11 h-11 rounded-xl border border-slate-200 text-xl hover:border-emerald-400 hover:bg-slate-50 flex items-center justify-center cursor-pointer transition-all shadow-2xs">💎</button>
          <button type="button" onclick="selectPresetIcon('\u{1F343}')" class="icon-choice-btn w-11 h-11 rounded-xl border border-slate-200 text-xl hover:border-emerald-400 hover:bg-slate-50 flex items-center justify-center cursor-pointer transition-all shadow-2xs">🍃</button>
        </div>
      </div>

      <!-- Tema Warna Cerah -->
      <div class="space-y-1">
        <label class="text-[10.5px] font-bold text-slate-500 uppercase">Tema Warna:</label>
        <div class="flex gap-2 flex-wrap" id="themeButtonsContainer">
          <button type="button" onclick="setTheme('emerald')" id="themeBtn_emerald" class="theme-choice-btn px-3 py-1.5 rounded-xl border border-emerald-300 bg-emerald-100 text-emerald-900 text-xs font-black cursor-pointer shadow-2xs">🟢 Emerald Mint</button>
          <button type="button" onclick="setTheme('amber')" id="themeBtn_amber" class="theme-choice-btn px-3 py-1.5 rounded-xl border border-amber-300 bg-amber-100 text-amber-900 text-xs font-black cursor-pointer shadow-2xs">🟡 Amber Gold</button>
          <button type="button" onclick="setTheme('blue')" id="themeBtn_blue" class="theme-choice-btn px-3 py-1.5 rounded-xl border border-blue-300 bg-blue-100 text-blue-900 text-xs font-black cursor-pointer shadow-2xs">🔵 Sky Blue</button>
          <button type="button" onclick="setTheme('purple')" id="themeBtn_purple" class="theme-choice-btn px-3 py-1.5 rounded-xl border border-purple-300 bg-purple-100 text-purple-900 text-xs font-black cursor-pointer shadow-2xs">🟣 Lavender</button>
        </div>
      </div>

      
      <!-- Kunci PIN Keamanan Keluarga -->
      <div class="p-3 bg-slate-50 border border-slate-200/80 rounded-2xl space-y-2">
        <div class="flex items-center justify-between">
          <div>
            <div class="text-xs font-black text-slate-800">Kunci PIN 8 Digit (Keamanan)</div>
            <div class="text-[10px] text-slate-400">Kunci aplikasi saat dibuka orang lain</div>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="settingPinToggle" onchange="handlePinToggleChange(event)" class="sr-only peer">
            <div class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-500"></div>
          </label>
        </div>
        <div id="changePinSection" class="pt-2 border-t border-slate-200/60 flex items-center gap-2">
          <input type="password" id="settingNewPinInput" maxlength="8" placeholder="Ubah PIN (4-8 Digit)" class="w-full bg-white border border-slate-200 rounded-lg px-2.5 py-1 text-xs font-bold text-slate-800">
          <button type="button" onclick="handleSaveNewPin()" class="px-3 py-1 rounded-lg bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-xs shrink-0 cursor-pointer transition-all shadow-2xs">Simpan PIN</button>
        </div>
        <div class="pt-1 flex items-center justify-between gap-2 border-t border-slate-200/40">
          <button type="button" onclick="copyWifePairingLink()" class="flex-1 py-1.5 px-2.5 rounded-lg bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-700 text-[10.5px] font-bold transition-all flex items-center justify-center gap-1 cursor-pointer">
            <span>📲 Salin Link Akses Umma Atin (Auto-Login)</span>
          </button>
          <button type="button" onclick="resetDefaultPin()" class="py-1.5 px-2.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 text-[10.5px] font-medium transition-all cursor-pointer" title="Kembalikan ke PIN Default 2429">
            <span>↺ Reset</span>
          </button>
        </div>
      </div>


      <!-- URL Google Apps Script Web App -->
      <div class="space-y-1 pt-2 border-t border-slate-100">
        <label class="text-[10.5px] font-bold text-slate-500 uppercase">URL Google Spreadsheet Web App (Gratis):</label>
        <input type="url" id="settingSpreadsheetUrlInput" placeholder="https://script.google.com/macros/s/.../exec" value="https://script.google.com/macros/s/AKfycbyB7_urRr_uBMeF6_n18p-ia1XwrRVgtiHmVs1gyV2NTU7OxTLAQXyQQNo_T5ETDdkH/exec" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold text-slate-800">
        <p class="text-[9.5px] text-slate-400">Kode Apps Script tersedia di berkas <code>google-apps-script.js</code>.</p>
      </div>

      <!-- Tombol Sinkronisasi Cloud & Pembersihan Cache Data Contoh -->
      <div class="pt-2 border-t border-slate-100 flex flex-col gap-1.5">
        <button type="button" onclick="handleForceCloudSync()" class="w-full py-2.5 px-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-black transition-all flex items-center justify-center gap-2 shadow-sm cursor-pointer">
          <span>🔄 Sinkronkan Ulang Cloud &amp; Kosongkan Data Contoh Lokal</span>
        </button>
        <p class="text-[9.5px] text-slate-400 text-center">Menghapus data contoh lama di browser ini dan menarik data asli langsung dari Google Sheets.</p>
      </div>

      <!-- Backup & Restore -->
      <div class="pt-2 border-t border-slate-100 flex gap-2">
        <button onclick="window.BackupRestoreModule.exportBackupJson()" class="flex-1 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold cursor-pointer">
          📥 Backup JSON
        </button>
        <label class="flex-1 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold text-center cursor-pointer">
          📤 Restore JSON
          <input type="file" accept=".json" onchange="handleRestoreFileChange(event)" class="hidden">
        </label>
      </div>

      <!-- Shortcut Kelola Kategori & Dompet -->
      <div class="pt-2 border-t border-slate-100 grid grid-cols-2 gap-2">
        <button type="button" onclick="closeSettingsModal(); openCategoryManagerModal();" class="py-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-800 text-xs font-bold flex items-center justify-center gap-1 cursor-pointer transition-all border border-emerald-200/60">
          <span>📁 Kelola Kategori</span>
        </button>
        <button type="button" onclick="closeSettingsModal(); openWalletManagerModal();" class="py-2 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-800 text-xs font-bold flex items-center justify-center gap-1 cursor-pointer transition-all border border-blue-200/60">
          <span>💳 Kelola Dompet</span>
        </button>
      </div>

      <!-- Atur Saldo Awal Dompet -->
      <div class="space-y-2 pt-2 border-t border-slate-100">
        <label class="text-[10.5px] font-bold text-slate-500 uppercase">Atur Saldo Nyata Dompet Anda (Rp):</label>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <div>
            <span class="text-[10px] font-bold text-slate-400">Kas Baba Pangestu:</span>
            <input type="number" id="settingWalletKasSuami" placeholder="0" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-2 py-1 font-bold">
          </div>
          <div>
            <span class="text-[10px] font-bold text-slate-400">Kas Dapur Umma Atin:</span>
            <input type="number" id="settingWalletKasDapur" placeholder="0" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-2 py-1 font-bold">
          </div>
          <div>
            <span class="text-[10px] font-bold text-slate-400">Rekening BCA:</span>
            <input type="number" id="settingWalletBca" placeholder="0" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-2 py-1 font-bold">
          </div>
          <div>
            <span class="text-[10px] font-bold text-slate-400">ShopeePay:</span>
            <input type="number" id="settingWalletShopee" placeholder="0" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-2 py-1 font-bold">
          </div>
        </div>
      </div>

      <!-- Tombol Simpan Pengaturan -->
      <button onclick="saveAllSettings()" class="w-full py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold text-xs transition-all shadow-md cursor-pointer">
        Simpan Pengaturan
      </button>

      <!-- Zona Reset ke Rp 0 -->
      <div class="pt-3 border-t border-rose-100">
        <button onclick="handleResetAllDataToZero()" type="button" class="w-full py-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 font-extrabold text-xs border border-rose-200 transition-all cursor-pointer flex items-center justify-center gap-1.5">
          <span>🗑️ Kosongkan Semua Data & Mulai dari Rp 0</span>
        </button>
        <p class="text-[9.5px] text-slate-400 text-center mt-1">Hapus transaksi demo dan mulai catat keuangan nyata keluarga Anda.</p>
      </div>
    </div>
  </div>

  
  <!-- ================= MODAL: EDIT TRANSAKSI (CRUD UPDATE) ================= -->
  <div id="editTxModal" class="modal-backdrop hidden">
    <div class="modal-content space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <h3 class="text-sm font-black text-slate-900">✏️ Edit Transaksi (CRUD)</h3>
        <button onclick="closeEditModal()" class="w-7 h-7 rounded-full bg-slate-100 text-slate-400 hover:text-slate-700 flex items-center justify-center">✕</button>
      </div>

      <input type="hidden" id="editTxId">

      <!-- Tanggal Backdate & Jenis Transaksi -->
      <div class="grid grid-cols-2 gap-2.5">
        <div class="space-y-1">
          <label class="text-[10.5px] font-bold text-slate-500 uppercase">Tanggal (Backdate):</label>
          <input type="date" id="editTxDate" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-800 outline-none">
        </div>
        <div class="space-y-1">
          <label class="text-[10.5px] font-bold text-slate-500 uppercase">Jenis Arus Kas:</label>
          <select id="editTxType" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-800 outline-none">
            <option value="expense">📤 Pengeluaran</option>
            <option value="income">📥 Pemasukan</option>
            <option value="transfer">⇄ Pindah Saldo</option>
          </select>
        </div>
      </div>

      <!-- Nominal -->
      <div class="space-y-1">
        <label class="text-[10.5px] font-bold text-slate-500 uppercase">Nominal Transaksi (Rp):</label>
        <input type="number" id="editTxAmount" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-sm font-black text-slate-900 outline-none">
      </div>

      <!-- Pos Kategori -->
      <div class="space-y-1">
        <label class="text-[10.5px] font-bold text-slate-500 uppercase">Kategori:</label>
        <input type="text" id="editTxCategory" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-800 outline-none">
      </div>

      <!-- Dompet & User -->
      <div class="grid grid-cols-2 gap-2.5">
        <div class="space-y-1">
          <label class="text-[10.5px] font-bold text-slate-500 uppercase">Dompet / Akun:</label>
          <select id="editTxWallet" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-800 outline-none">
            <option value="Kas Tunai Suami">Kas Tunai Suami</option>
            <option value="Kas Dapur (Istri)">Kas Dapur (Istri)</option>
            <option value="Rekening BCA">Rekening BCA</option>
            <option value="Rekening Mandiri / BRI">Mandiri / BRI</option>
            <option value="ShopeePay (Istri)">ShopeePay</option>
            <option value="GoPay / OVO / DANA">GoPay / OVO</option>
          </select>
        </div>
        <div class="space-y-1">
          <label class="text-[10.5px] font-bold text-slate-500 uppercase">Pencatat:</label>
          <select id="editTxUser" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-800 outline-none">
            <option value="istri">👩 Umma Atin</option>
            <option value="suami">👨 Baba Pangestu</option>
          </select>
        </div>
      </div>

      <!-- Keterangan -->
      <div class="space-y-1">
        <label class="text-[10.5px] font-bold text-slate-500 uppercase">Keterangan / Catatan:</label>
        <input type="text" id="editTxNote" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold text-slate-800 outline-none">
      </div>

      <!-- Tombol Simpan Edit -->
      <div class="flex gap-2 pt-2">
        <button onclick="closeEditModal()" class="flex-1 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs">
          Batal
        </button>
        <button onclick="submitEditTransaction()" class="flex-1 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-black text-xs">
          Simpan Perubahan
        </button>
      </div>
    </div>
  </div>

  <!-- ================= MODAL: EDIT TRANSAKSI USAHA IBU (CRUD UPDATE) ================= -->
  <div id="editIbuTxModal" class="modal-backdrop hidden">
    <div class="modal-content space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <div class="flex items-center gap-2">
          <span class="text-base">✏️</span>
          <h3 class="text-sm font-black text-slate-900">Edit Transaksi Usaha Ibu</h3>
        </div>
