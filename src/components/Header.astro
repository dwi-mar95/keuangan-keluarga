---
---
  <header class="bg-white/90 backdrop-blur-md border-b border-slate-200/80 sticky top-0 z-30 transition-all">
    <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between gap-3">
      
      <!-- Brand & Family Name -->
      <div class="flex items-center gap-2.5 min-w-0 cursor-pointer" onclick="openSettingsModal()">
        <div id="headerLogoIcon" class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 border border-emerald-200/60 flex items-center justify-center text-xl shrink-0 shadow-2xs">
          🏡
        </div>
        <div class="min-w-0">
          <h1 id="headerFamilyName" class="text-sm font-extrabold text-slate-900 truncate">
            Keluarga Baba Pangestu & Umma Atin
          </h1>
          <p id="headerCurrentDate" class="text-[10px] font-semibold text-slate-400">
            Kamis, 03 September 2026
          </p>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-1.5 shrink-0">
        <!-- Privacy Toggle -->
        <button id="btnPrivacyToggle" onclick="handleTogglePrivacy()" class="w-8 h-8 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-all cursor-pointer" title="Mode Privasi (Sensor Saldo)">
          <i id="privacyEyeIcon" data-lucide="eye" class="w-4 h-4"></i>
        </button>

        
        <!-- Sync Google Sheets Button -->
        <button onclick="handleManualSyncGoogleSheets()" class="w-8 h-8 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-700 flex items-center justify-center transition-all cursor-pointer" title="Sinkronkan dengan Google Sheets">
          <i data-lucide="refresh-cw" class="w-4 h-4"></i>
        </button>

        <!-- WhatsApp Rekap Share -->
        <button onclick="handleShareRekapWA()" class="w-8 h-8 rounded-lg bg-emerald-100 hover:bg-emerald-200 text-emerald-700 flex items-center justify-center transition-all cursor-pointer" title="Bagikan Rekap ke WA">
          <i data-lucide="share-2" class="w-4 h-4"></i>
        </button>

        <!-- Laporan & Ekspor (Excel / PDF) -->
        <button onclick="openTabModal('reports')" class="w-8 h-8 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-700 flex items-center justify-center transition-all cursor-pointer" title="Laporan & Ekspor (Excel/PDF)">
          <i data-lucide="file-spreadsheet" class="w-4 h-4"></i>
        </button>

        <!-- Lock Screen Button -->
        <button onclick="lockAppNow()" class="w-8 h-8 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-all cursor-pointer" title="Kunci Aplikasi (PIN)">
          <i data-lucide="lock" class="w-4 h-4"></i>
        </button>

        <!-- Settings -->
        <button onclick="openSettingsModal()" class="w-8 h-8 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-all cursor-pointer" title="Pengaturan">
          <i data-lucide="settings" class="w-4 h-4"></i>
        </button>
      </div>
    </div>

    <!-- Dual Ledger Bar (Keluarga vs Usaha Ibu) -->
    <div class="max-w-5xl mx-auto px-4 pb-2.5 flex items-center justify-between gap-2 overflow-x-auto no-scrollbar">
      <!-- Ledger Switcher -->
      <div class="flex p-0.5 bg-slate-100 rounded-xl border border-slate-200/80 shrink-0">
        <button id="btnLedgerKeluarga" onclick="switchLedger('keluarga')" class="px-3 py-1 rounded-lg text-xs font-bold bg-white text-slate-900 shadow-2xs transition-all flex items-center gap-1.5">
          <span>🏡 Kas Keluarga</span>
          <span id="badgeCountKeluarga" class="text-[9.5px] px-1.5 py-0.2 rounded-full bg-slate-100 text-slate-600 font-black">0</span>
        </button>
        <button id="btnLedgerIbu" onclick="switchLedger('ibu')" class="px-3 py-1 rounded-lg text-xs font-bold text-slate-500 hover:text-slate-800 transition-all flex items-center gap-1.5">
          <span>🏢 Usaha Ibu</span>
          <span id="badgeCountIbu" class="text-[9.5px] px-1.5 py-0.2 rounded-full bg-amber-100 text-amber-900 font-black">0</span>
        </button>
      </div>

      <!-- Profile Filter (Khusus Kas Keluarga) -->
      <div id="profileSwitcherContainer" class="flex items-center gap-1 shrink-0">
        <span class="text-[10px] font-bold text-slate-400 mr-1 hidden sm:inline">Lihat:</span>
        <button onclick="switchProfile('keluarga')" id="btnProfKeluarga" class="px-2 py-0.5 rounded-md text-[10.5px] font-bold bg-emerald-100 text-emerald-800">
          👨‍👩‍👧‍👦 Semua
        </button>
        <button onclick="switchProfile('suami')" id="btnProfSuami" class="px-2 py-0.5 rounded-md text-[10.5px] font-bold text-slate-500 hover:bg-slate-100">
          👨 Baba Pangestu
        </button>
        <button onclick="switchProfile('istri')" id="btnProfIstri" class="px-2 py-0.5 rounded-md text-[10.5px] font-bold text-slate-500 hover:bg-slate-100">
          👩 Umma Atin
        </button>
      </div>
    </div>
  </header>

