---
---
    <section id="sectionKeluarga" class="space-y-4">

      <!-- Multi-Wallet Balance Strip -->
      <div class="glass-card p-3.5 flex items-center gap-3 overflow-x-auto no-scrollbar">
        <div class="flex items-center gap-2 pl-1 pr-3 border-r border-slate-200 shrink-0">
          <i data-lucide="wallet" class="w-4 h-4 text-emerald-600"></i>
          <span class="text-[11px] font-extrabold text-slate-700">Dompet:</span>
        </div>
        <div id="dynamicWalletBar" class="flex items-center gap-2 shrink-0">
          <!-- Populated dynamically: BSI, BCA, Flip, Kas Baba, Kas Umma, ShopeePay, etc -->
        </div>
        <div class="flex items-center gap-1.5 shrink-0">
          <button onclick="openTransferModal()" class="px-2 py-1 rounded-lg bg-blue-100 hover:bg-blue-200 text-blue-800 text-[10px] font-extrabold shrink-0 cursor-pointer shadow-2xs flex items-center gap-1">
            <span>⇄</span>
            <span>Pindah Saldo</span>
          </button>
          <button onclick="openWalletManagerModal()" class="px-2 py-1 rounded-lg bg-emerald-100 hover:bg-emerald-200 text-emerald-800 text-[10px] font-extrabold shrink-0 cursor-pointer shadow-2xs">
            + Kelola Dompet
          </button>
        </div>
      </div>

      <!-- 4 Primary KPI Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <!-- Pemasukan -->
        <div class="glass-card p-3.5 space-y-1">
          <div class="flex items-center justify-between text-[10px] font-bold text-slate-400 uppercase tracking-wider">
            <span>Pemasukan</span>
            <span class="text-emerald-500">📥</span>
          </div>
          <div id="kpiTotalIncome" class="text-lg font-black text-emerald-600">Rp 0</div>
          <div class="text-[9.5px] text-slate-400 font-semibold">Bulan Ini (WIB)</div>
        </div>

        <!-- Pengeluaran -->
        <div class="glass-card p-3.5 space-y-1">
          <div class="flex items-center justify-between text-[10px] font-bold text-slate-400 uppercase tracking-wider">
            <span>Belanja</span>
            <span class="text-rose-500">📤</span>
          </div>
          <div id="kpiTotalExpense" class="text-lg font-black text-rose-600">Rp 0</div>
          <div class="text-[9.5px] text-slate-400 font-semibold">Dapur, anak, tagihan</div>
        </div>

        <!-- Tagihan Pending -->
        <div class="glass-card p-3.5 space-y-1">
          <div class="flex items-center justify-between text-[10px] font-bold text-slate-400 uppercase tracking-wider">
            <span>Tagihan Sisa</span>
            <span class="text-amber-500">⏳</span>
          </div>
          <div id="kpiPendingBills" class="text-lg font-black text-amber-600">Rp 0</div>
          <div class="text-[9.5px] text-slate-400 font-semibold">Listrik, Wifi, Air</div>
        </div>

        <!-- Sisa Anggaran Bebas -->
        <div class="glass-card p-3.5 space-y-1 bg-gradient-to-br from-emerald-500/10 to-teal-500/5 border-emerald-200/80">
          <div class="flex items-center justify-between text-[10px] font-bold text-emerald-700 uppercase tracking-wider">
            <span>Sisa Kas Bebas</span>
            <span class="text-emerald-600">💰</span>
          </div>
          <div id="kpiFreeBudget" class="text-lg font-black text-emerald-700">Rp 0</div>
          <div class="text-[9.5px] text-emerald-600 font-semibold">Surplus tabungan</div>
        </div>
      </div>

      <!-- Quick Preset 1-Sentuh Bar (Fast Entry) -->
      <div class="bg-white border border-slate-200/80 rounded-xl p-3 flex items-center justify-between gap-2 overflow-x-auto no-scrollbar shadow-2xs">
        <span class="text-[10px] font-bold text-slate-400 uppercase whitespace-nowrap pl-1">Pintasan 1-Klik:</span>
        <div id="dynamicPresetsContainer" class="flex items-center gap-1.5 shrink-0">
          <!-- Populated dynamically -->
        </div>
        <button onclick="openPresetsManagerModal()" class="px-2 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 text-[10px] font-bold shrink-0 cursor-pointer">
          ⚙️ Kelola Pintasan
        </button>
      </div>

      <!-- Sub-Features Navigation Grid (100% Dinamis: Tambah, Edit, Hapus) -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between px-1">
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Menu Fitur Cepat:</span>
          <button onclick="openManageFeaturesModal()" class="text-[10.5px] font-bold text-emerald-600 hover:text-emerald-700 flex items-center gap-1 cursor-pointer bg-emerald-50 hover:bg-emerald-100 px-2 py-0.5 rounded-lg transition-all">
            <span>⚙️ Atur / + Menu</span>
          </button>
        </div>
        <div id="dynamicFeatureShortcutsContainer" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2 text-xs font-bold">
          <!-- Populated dynamically by renderDynamicFeatureShortcuts() -->
        </div>
      </div>

      <!-- ================= WIDGET: JADWAL & TAGIHAN TERDEKAT (7 HARI KE DEPAN) ================= -->
      <div id="upcomingDueDatesContainer" class="transition-all">
        <!-- Populated dynamically by renderUpcomingDueWidget() -->
      </div>

      <!-- Family Net Worth & Emergency Fund Banner -->
      <div class="glass-card p-4 bg-gradient-to-br from-slate-900 via-slate-950 to-slate-900 text-white flex items-center justify-between gap-4 flex-wrap">
        <div class="space-y-1">
          <div class="text-[10px] font-extrabold uppercase tracking-widest text-emerald-400 flex items-center gap-1.5">
            <i data-lucide="shield-check" class="w-4 h-4"></i>
            Kekayaan Bersih Keluarga (Family Net Worth)
          </div>
          <div id="kpiNetWorth" class="text-2xl font-black text-white">Rp 0</div>
          <div class="text-[10px] text-slate-400 font-medium">
            Kas Likuid + Dana Darurat (Rp 26jt) + Emas Antam (15g) + Reksa Dana
          </div>
        </div>
        <button onclick="openTabModal('investments')" class="px-3.5 py-1.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-black text-xs transition-all cursor-pointer">
          Lihat Investasi & Emas ➔
        </button>
      </div>

      <!-- SMART DASHBOARD ROW: SKOR KESEHATAN FINANSIAL & CELENGAN IMPIAN -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Card 1: Skor Kesehatan Finansial & Rasio 50/30/20 -->
        <div class="glass-card p-4 space-y-3 border-l-4 border-l-emerald-500">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-base">📊</div>
              <div>
                <h3 class="text-xs font-black text-slate-900">Kesehatan Finansial Keluarga</h3>
                <p id="dashboardHealthStatus" class="text-[10px] text-slate-400 font-medium">Analisis rasio kebutuhan vs tabungan...</p>
              </div>
            </div>
            <div id="dashboardHealthBadge" class="px-2.5 py-1 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-black">
              Grade A+
            </div>
          </div>

          <!-- Rasio 50/30/20 Mini Bar -->
          <div class="space-y-1.5 pt-1">
            <div class="flex justify-between text-[10px] font-bold">
              <span class="text-slate-500">Alokasi Anggaran (Kebutuhan / Keinginan / Tabungan):</span>
              <span id="dashboardHealthScoreText" class="text-emerald-600 font-extrabold">Skor 88/100</span>
            </div>
            <div class="h-3 w-full bg-slate-100 rounded-full overflow-hidden flex shadow-inner">
              <div id="barNeeds" class="bg-emerald-500 h-full transition-all" style="width: 50%" title="Kebutuhan Pokok (Target 50%)"></div>
              <div id="barWants" class="bg-amber-400 h-full transition-all" style="width: 25%" title="Keinginan & Rekreasi (Target 30%)"></div>
              <div id="barSavings" class="bg-blue-500 h-full transition-all" style="width: 25%" title="Tabungan & Investasi (Target 20%)"></div>
            </div>
            <div class="flex justify-between text-[9.5px] text-slate-400 pt-0.5">
              <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span> Kebutuhan: <strong id="lblNeeds" class="text-slate-700">50%</strong></span>
              <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-amber-400 inline-block"></span> Keinginan: <strong id="lblWants" class="text-slate-700">25%</strong></span>
              <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-blue-500 inline-block"></span> Tabungan: <strong id="lblSavings" class="text-slate-700">25%</strong></span>
            </div>
          </div>

          <div class="pt-1 flex items-center justify-between border-t border-slate-100">
            <span class="text-[10px] text-slate-400 italic truncate max-w-[240px]" id="dashboardHealthTip">"Alokasi tabungan dan investasi Anda sangat prima."</span>
            <button type="button" onclick="openTabModal('health')" class="text-xs font-bold text-emerald-600 hover:text-emerald-700 underline shrink-0 cursor-pointer">Detail ➔</button>
          </div>
        </div>

        <!-- Card 2: Celengan Target Impian Keluarga -->
        <div class="glass-card p-4 space-y-3 border-l-4 border-l-purple-500">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center text-base">🎯</div>
              <div>
                <h3 class="text-xs font-black text-slate-900">Celengan Target Impian</h3>
                <p id="dashboardGoalsSubtitle" class="text-[10px] text-slate-400 font-medium">Qurban, Umrah, & Impian Keluarga</p>
              </div>
            </div>
            <button type="button" onclick="openTabModal('goals')" class="px-2.5 py-1 rounded-xl bg-purple-50 hover:bg-purple-100 text-purple-700 text-xs font-black transition-all cursor-pointer">
              + Kelola
            </button>
          </div>

          <!-- Preview Goals Mini List -->
          <div id="dashboardGoalsList" class="space-y-2 pt-1">
            <!-- Injected dynamically -->
          </div>

          <div class="pt-1 flex items-center justify-between border-t border-slate-100">
            <span class="text-[10px] text-slate-400">Total terkumpul: <strong id="dashboardGoalsTotalSaved" class="text-purple-700">Rp 0</strong></span>
            <button type="button" onclick="openTabModal('goals')" class="text-xs font-bold text-purple-600 hover:text-purple-700 underline cursor-pointer">Lihat Semua Celengan ➔</button>
          </div>
        </div>
      </div>

      <!-- Charts Row -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Donut Kategori -->
        <div class="glass-card p-4 space-y-3">
          <h3 class="text-xs font-black text-slate-800 uppercase tracking-wider flex items-center gap-1.5">
            <i data-lucide="pie-chart" class="w-4 h-4 text-emerald-500"></i>
            Proporsi Pengeluaran Kategori
          </h3>
          <div class="h-56 relative">
            <canvas id="categoryChart"></canvas>
          </div>
        </div>

        <!-- Komparasi Belanja Suami vs Istri -->
        <div class="glass-card p-4 space-y-3">
          <h3 class="text-xs font-black text-slate-800 uppercase tracking-wider flex items-center gap-1.5">
            <i data-lucide="users" class="w-4 h-4 text-blue-500"></i>
            Belanja: Baba Pangestu vs Umma Atin
          </h3>
          <div class="h-56 relative">
            <canvas id="spouseComparisonChart"></canvas>
          </div>
        </div>
      </div>

      <!-- ================= HELICOPTER VIEW: STATISTIK & KOMPARASI TREN BULANAN ================= -->
      <div id="helicopterStatsContainer" class="glass-card p-4 space-y-4">
        <!-- Injected dynamically by window.MonthlyStatsModule.renderMonthlyHelicopterView() -->
      </div>

      <!-- Riwayat Transaksi Terbaru -->
      <div class="glass-card p-4 space-y-3">
        <div class="flex items-center justify-between flex-wrap gap-2">
          <h3 class="text-xs font-black text-slate-800 uppercase tracking-wider flex items-center gap-1.5">
            <i data-lucide="clock" class="w-4 h-4 text-slate-400"></i>
            Riwayat Transaksi (WIB)
          </h3>
          <div class="flex items-center gap-2">
            <span id="filteredTxCountBadge" class="text-[10px] font-bold bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full">0 Transaksi</span>
            <button onclick="window.BackupRestoreModule.exportTransactionsToCsv(window.AppModule.getFilteredTransactions())" class="text-[10px] font-bold text-emerald-600 hover:text-emerald-700 cursor-pointer">
              Export CSV Excel
            </button>
          </div>
        </div>

        <!-- SEARCH & DATE FILTER BAR -->
        <div class="p-3 bg-slate-50 border border-slate-200/80 rounded-2xl space-y-2.5">
          <!-- Kotak Pencarian Teks -->
          <div class="relative">
            <input 
              type="text" 
              id="txSearchInput" 
              oninput="handleSearchAndFilterChange()" 
              placeholder="🔍 Cari nama barang, keterangan, kategori (misal: beras, bensin, shopee)..." 
              class="w-full bg-white border border-slate-200 rounded-xl pl-3 pr-8 py-2 text-xs font-semibold text-slate-800 outline-none focus:border-emerald-500 shadow-2xs"
            >
            <button onclick="document.getElementById('txSearchInput').value=''; handleSearchAndFilterChange();" class="absolute right-2.5 top-2 text-slate-300 hover:text-slate-600 text-xs font-bold">✕</button>
          </div>

          <!-- Filter Rentang Tanggal & Dropdown -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs">
            <!-- Dari Tanggal -->
            <div class="flex items-center gap-1.5 bg-white border border-slate-200 rounded-xl px-2.5 py-1.5">
              <span class="text-[10px] font-bold text-slate-400 uppercase whitespace-nowrap">Dari:</span>
              <input type="date" id="filterStartDate" onchange="handleSearchAndFilterChange()" class="w-full text-xs font-bold text-slate-700 outline-none cursor-pointer">
            </div>

            <!-- Sampai Tanggal -->
            <div class="flex items-center gap-1.5 bg-white border border-slate-200 rounded-xl px-2.5 py-1.5">
              <span class="text-[10px] font-bold text-slate-400 uppercase whitespace-nowrap">Sampai:</span>
              <input type="date" id="filterEndDate" onchange="handleSearchAndFilterChange()" class="w-full text-xs font-bold text-slate-700 outline-none cursor-pointer">
            </div>

            <!-- Preset Tanggal Cepat -->
            <div class="flex items-center gap-1 overflow-x-auto no-scrollbar">
              <button onclick="setFilterPreset('semua')" class="px-2 py-1 rounded-lg bg-white border border-slate-200 hover:bg-slate-100 text-[10px] font-bold text-slate-600">Semua</button>
              <button onclick="setFilterPreset('hari')" class="px-2 py-1 rounded-lg bg-white border border-slate-200 hover:bg-slate-100 text-[10px] font-bold text-slate-600">Hari Ini</button>
              <button onclick="setFilterPreset('minggu')" class="px-2 py-1 rounded-lg bg-white border border-slate-200 hover:bg-slate-100 text-[10px] font-bold text-slate-600">7 Hari</button>
              <button onclick="setFilterPreset('bulan')" class="px-2 py-1 rounded-lg bg-white border border-slate-200 hover:bg-slate-100 text-[10px] font-bold text-slate-600">Bulan Ini</button>
            </div>
          </div>

          <!-- Filter Jenis Transaksi -->
          <div class="flex items-center justify-between flex-wrap gap-2 pt-1 border-t border-slate-200/60 text-[10.5px]">
            <div class="flex items-center gap-1.5 font-bold text-slate-500">
              <span>Jenis:</span>
              <select id="filterTypeSelect" onchange="handleSearchAndFilterChange()" class="bg-white border border-slate-200 rounded-lg px-2 py-0.5 text-slate-800 font-bold outline-none">
                <option value="all">Semua Jenis</option>
                <option value="expense">Pengeluaran Saja</option>
                <option value="income">Pemasukan Saja</option>
              </select>
            </div>

            <button onclick="resetAllFilters()" class="text-slate-400 hover:text-rose-600 font-bold transition-colors">
              ↺ Reset Filter
            </button>
          </div>
        </div>
        <div id="recentTxList" class="space-y-2">
          <!-- Populated by app.js -->
        </div>
      </div>

    </section>


    <!-- ================= BUKU 2: USAHA IBU TERPISAH ================= -->
